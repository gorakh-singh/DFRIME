# Copy this file to .env and fill in a real key.
#
#   cp .env.example .env
#
# .env is gitignored. The key is read by the Node process only. It is never
# sent to the browser, never written into a clip manifest, and never printed
# in script output or error messages.
#
# Get a key from https://app.rime.ai/tokens/
RIME_API_KEY=rime_your_key_here

# Optional. Port for the local server. Defaults to 5311.
PORT=5311
